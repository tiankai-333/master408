# deploy/.env.acr.example — 阿里云镜像仓库配置模板
# 复制为 .env.acr 并填入真实值：cp deploy/.env.acr.example deploy/.env.acr
# deploy/.env.acr 已在 .gitignore 中，不会被提交

# 阿里云 ACR 区域
ACR_REGION=cn-hangzhou

# 镜像仓库地址（个人版格式）
ACR_REGISTRY=crpi-xxxxxxxxx.cn-hangzhou.personal.cr.aliyuncs.com

# 命名空间（个人版为阿里云账号命名空间）
ACR_NAMESPACE=你的命名空间

# 仓库名称
ACR_REPO=408master

# 阿里云账号（手机号或 RAM 子账号）
ACR_USERNAME=你的阿里云账号

# 容器镜像服务访问凭证密码（不是阿里云登录密码）
ACR_PASSWORD=你的ACR密码

# 镜像 tag（默认用日期）
IMAGE_TAG=latest

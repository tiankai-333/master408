<wxs module="enumItem" src="../../../wxs/enumItem.wxs"></wxs>
<view class="page">
  <view class="error-list" wx:if="{{tableData.length > 0}}">
    <view class="error-card" wx:for="{{tableData}}" wx:key="{{item.id}}" data-id="{{item.id}}" bind:tap="goDetail">
      <view class="error-card-body">
        <view class="error-card-title">{{item.shortTitle || '题目'}}</view>
        <view class="error-card-meta">
          <text wx:if="{{item.subjectName}}">{{item.subjectName}}</text>
          <text wx:if="{{item.createTime}}"> · {{item.createTime}}</text>
        </view>
      </view>
      <view class="error-card-tag">
        <text>{{enumItem.format(enumItem.state.exam.question.typeEnum, item.questionType)}}</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:elif="{{!spinShow}}">
    <text>暂无错题，继续保持！</text>
  </view>

  <i-load-more tip="{{loadMoreTip}}" loading="{{loadMoreLoad}}" wx:if="{{tableData.length > 0}}" />
  <i-spin size="large" fix wx:if="{{spinShow}}"></i-spin>
  <i-message id="message" />
</view>

.page {
  background: #f5f7fb;
  min-height: 100vh;
  padding: 12px;
}

.error-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.error-card {
  display: flex;
  align-items: center;
  padding: 14px 16px;
  background: #fff;
  border-radius: 10px;
  border: 1px solid #e2e8f0;
}

.error-card-body {
  flex: 1;
  min-width: 0;
}

.error-card-title {
  font-size: 15px;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.error-card-meta {
  margin-top: 6px;
  font-size: 12px;
  color: #94a3b8;
}

.error-card-tag {
  margin-left: 10px;
  padding: 4px 10px;
  border-radius: 999px;
  background: #fef2f2;
  color: #dc2626;
  font-size: 12px;
  white-space: nowrap;
}

.empty-tip {
  text-align: center;
  padding: 80px 20px;
  color: #94a3b8;
  font-size: 14px;
}

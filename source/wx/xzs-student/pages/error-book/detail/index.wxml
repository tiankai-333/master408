<wxs module="filter" src="../../../wxs/exam-fun.wxs"></wxs>
<view class="exam-page" wx:if="{{questionVM}}">
  <view class="view-wrap-hidden"></view>

  <view>
    <i-panel title="题目内容">
      <i-cell-group>
        <i-cell>
          <view wx:if="{{questionVM.questionType === 1}}">
            <rich-text nodes="{{questionVM.title}}" />
            <radio-group class="radio-group">
              <label class="exam-radio-item-label" wx:for="{{questionVM.items}}" wx:key="{{item.prefix}}" wx:for-item="radioItem">
                <radio color="#2d8cf0" value="{{radioItem.prefix}}" checked="{{radioItem.prefix == answerVM.content}}" class="exam-item-left" disabled="{{true}}" />
                <rich-text nodes="{{radioItem.prefix}}. {{radioItem.content}}" class="exam-item-left {{radioItem.prefix == answerVM.content ? 'item-content-selected' : ''}}" />
              </label>
            </radio-group>
          </view>

          <view wx:elif="{{questionVM.questionType === 2}}">
            <rich-text nodes="{{questionVM.title}}" class="exam-item-left" style="line-height:35px" />
            <checkbox-group class="exam-item-left" style="margin-left:10px">
              <label wx:for="{{questionVM.items}}" wx:key="{{item.prefix}}" wx:for-item="radioItem" class="exam-radio-item-label">
                <checkbox color="#2d8cf0" value="{{radioItem.prefix}}" checked="{{filter.indexOf(answerVM.content,radioItem.prefix)}}" class="exam-item-left" disabled="{{true}}" />
                <rich-text nodes="{{radioItem.prefix}}. {{radioItem.content}}" class="exam-item-left {{filter.indexOf(answerVM.content,radioItem.prefix) ? 'item-content-selected' : ''}}" />
              </label>
            </checkbox-group>
          </view>

          <view wx:elif="{{questionVM.questionType === 3}}">
            <rich-text nodes="{{questionVM.title}}" class="exam-item-left" style="line-height:35px" />
            <radio-group class="radio-group" style="margin-left:10px">
              <label class="exam-radio-item-label" wx:for="{{questionVM.items}}" wx:key="{{item.prefix}}" wx:for-item="radioItem">
                <radio color="#2d8cf0" value="{{radioItem.prefix}}" checked="{{radioItem.prefix == answerVM.content}}" class="exam-item-left" disabled="{{true}}" />
                <rich-text nodes="{{radioItem.content}}" class="exam-item-left" />
              </label>
            </radio-group>
          </view>

          <view wx:elif="{{questionVM.questionType === 4}}">
            <rich-text nodes="{{questionVM.title}}" />
            <view class="exam-input-contain" wx:for="{{questionVM.items}}" wx:key="{{item.prefix}}" wx:for-item="inputItem" wx:for-index="idx">
              <view class="exam-input-contain-label">{{inputItem.prefix}}</view>
              <input class="exam-input-contain-content" maxlength="-1" value="{{answerVM.contentArray[idx]}}" disabled="{{true}}" />
            </view>
          </view>

          <view wx:else>
            <rich-text nodes="{{questionVM.title}}" />
            <view class="exam-textarea-contain">
              <textarea maxlength="-1" disabled="{{true}}" value="{{answerVM.content}}"></textarea>
            </view>
          </view>

          <view class="exam-clear">
            <view class="exam-extend-item" style="padding-left:0px">
              结果:
              <text class="question-answer-right question-answer-result" wx:if="{{answerVM.doRight==true}}">正确</text>
              <text class="question-answer-error question-answer-result" wx:elif="{{answerVM.doRight==false}}">错误</text>
              <text class="question-answer-judge question-answer-result" wx:elif="{{answerVM.doRight===null}}">待批改</text>
            </view>
            <view class="exam-extend-item" wx:if="{{answerVM.score != null}}">得分: {{answerVM.score}}</view>
            <view class="exam-extend-item">分数: {{questionVM.score}}</view>
            <view class="exam-extend-item" style="padding-left:0px">
              难度:
              <i-rate value="{{questionVM.difficult}}" i-class="exam-item-rate" />
            </view>
            <view class="exam-extend-item" wx:if="{{questionVM.analyze}}">
              <rich-text nodes="解析: {{questionVM.analyze}}" />
            </view>
            <view class="exam-extend-item">
              <rich-text nodes="正确答案: {{questionVM.correct}}" wx:if="{{questionVM.questionType==1||questionVM.questionType==2||questionVM.questionType==5}}" />
              <rich-text nodes="正确答案: {{filter.trueFalseFormatter(questionVM)}}" wx:elif="{{questionVM.questionType==3}}" />
              <rich-text nodes="正确答案: {{questionVM.correctArray}}" wx:elif="{{questionVM.questionType==4}}" />
            </view>
          </view>
        </i-cell>
      </i-cell-group>
    </i-panel>

    <i-panel title="AI 分析" i-class="ai-panel">
      <view class="ai-section">
        <view class="ai-style-row">
          <text class="ai-style-label">分析风格：</text>
          <picker mode="selector" range="{{aiStyleNames}}" value="{{aiStyleIndex}}" bindchange="onStyleChange">
            <view class="ai-style-picker">{{aiStyleNames[aiStyleIndex]}} ▾</view>
          </picker>
        </view>
        <i-button type="primary" size="small" bind:click="analyzeQuestion" loading="{{aiAnalyzing}}" disabled="{{aiAnalyzing}}">
          {{aiAnalyzing ? '分析中...' : 'AI分析'}}
        </i-button>
        <view class="ai-result" wx:if="{{aiResultHtml}}">
          <rich-text nodes="{{aiResultHtml}}" />
        </view>
        <view class="ai-empty" wx:elif="{{!aiAnalyzing}}">
          <text class="ai-empty-text">点击上方按钮获取 AI 解析</text>
        </view>
      </view>
    </i-panel>
  </view>

  <i-spin size="large" fix wx:if="{{spinShow}}"></i-spin>
  <i-spin size="large" fix wx:if="{{aiAnalyzing}}"></i-spin>
  <i-message id="message" />
</view>

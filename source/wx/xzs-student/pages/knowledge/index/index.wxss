.page {
  padding: 16px;
  background: #f5f7fa;
  min-height: 100vh;
}

.search-bar {
  margin-bottom: 12px;
}

.search-input {
  width: 100%;
  height: 40px;
  padding: 0 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #fff;
  font-size: 14px;
  box-sizing: border-box;
}

.empty-tip {
  text-align: center;
  padding: 40px 20px;
  color: #999;
  font-size: 13px;
}

.page {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

.search-bar {
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  background: #fff;
  font-size: 30rpx;
  box-sizing: border-box;
}

.subject-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subject-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.subject-header {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  gap: 16rpx;
}

.subject-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  flex: 1;
}

.subject-count {
  font-size: 26rpx;
  color: #9CA3AF;
}

.subject-arrow {
  font-size: 24rpx;
  color: #9CA3AF;
  padding-left: 12rpx;
}

.subject-points {
  border-top: 1rpx solid #F3F4F6;
}

.point-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.point-item:last-child {
  border-bottom: none;
}

.point-item:active {
  background: #F9FAFB;
}

.point-name {
  flex: 1;
  font-size: 30rpx;
  color: #374151;
  line-height: 1.5;
}

.point-arrow {
  font-size: 36rpx;
  color: #D1D5DB;
  padding-left: 16rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

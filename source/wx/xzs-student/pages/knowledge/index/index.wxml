<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索知识点"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
    />
  </view>

  <view class="subject-list">
    <view class="subject-card" wx:for="{{filteredGroups}}" wx:key="name">
      <view class="subject-header" bind:tap="toggleGroup" data-name="{{item.name}}">
        <text class="subject-name">{{item.name}}</text>
        <text class="subject-count">{{item.points.length}} 个知识点</text>
        <text class="subject-arrow">{{expandedGroup === item.name ? '▲' : '▼'}}</text>
      </view>
      <view class="subject-points" wx:if="{{expandedGroup === item.name}}">
        <view class="point-item"
              wx:for="{{item.points}}"
              wx:for-item="point"
              wx:key="id"
              data-id="{{point.id}}"
              bind:tap="goDetail">
          <text class="point-name">{{point.name}}</text>
          <text class="point-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!spinShow && filteredGroups.length === 0}}">
    <text>没有匹配的知识点</text>
  </view>

  <i-spin size="large" fix wx:if="{{spinShow}}"></i-spin>
  <i-message id="message" />
</view>

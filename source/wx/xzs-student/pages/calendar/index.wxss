.calendar-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
  background: #FAFAFE;
}

.month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx 16rpx 0 0;
  border: 1rpx solid #E0E7FF;
  border-bottom: none;
}

.month-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.month-arrow {
  font-size: 44rpx;
  color: #6366F1;
  padding: 0 16rpx;
}

.weekday-row {
  display: flex;
  background: #fff;
  border-left: 1rpx solid #E0E7FF;
  border-right: 1rpx solid #E0E7FF;
}

.weekday {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 600;
}

.calendar-grid {
  background: #fff;
  border: 1rpx solid #E0E7FF;
  border-top: none;
  border-radius: 0 0 16rpx 16rpx;
  padding-bottom: 12rpx;
}

.calendar-week {
  display: flex;
}

.calendar-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 0;
  position: relative;
}

.day-text {
  font-size: 28rpx;
  color: #111827;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
}

.calendar-day.is-today .day-text {
  background: #EEF2FF;
  color: #4F46E5;
  font-weight: 700;
}

.calendar-day.is-selected .day-text {
  background: #6366F1;
  color: #fff;
  font-weight: 700;
}

.study-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #A78BFA;
  margin-top: 4rpx;
}

.calendar-day.is-selected .study-dot {
  background: #fff;
}

.day-detail {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #E0E7FF;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.06);
}

.detail-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 20rpx;
}

.detail-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.detail-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #6366F1;
}

.detail-label {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 6rpx;
}

.detail-empty {
  text-align: center;
  padding: 40rpx 0;
  color: #6B7280;
  font-size: 26rpx;
}

.detail-action {
  margin-top: 16rpx;
  padding: 20rpx 0;
  text-align: center;
  background: #6366F1;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

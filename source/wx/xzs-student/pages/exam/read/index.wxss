.exam-page {
  background: #FAFAFE;
  min-height: 100vh;
}

.view-wrap-hidden {
  height: 15px;
}

.exam-name-title {
  text-align: center;
  padding: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.exam-result {
  text-align: center;
  padding: 24rpx;
}

.exam-result-score {
  font-size: 40rpx;
  font-weight: 800;
  color: #6366F1;
  margin-bottom: 12rpx;
}

.exam-result-time {
  font-size: 28rpx;
  color: #6B7280;
}

.exam-panel-title {
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #E0E7FF;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.06);
  overflow: hidden;
}

.exam-cell {
  padding: 0 !important;
}

.exam-question-block {
  padding: 28rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.exam-question-block:last-child {
  border-bottom: none;
}

.exam-question-title {
  font-size: 30rpx;
  color: #111827;
  line-height: 1.7;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.exam-option-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.exam-option-label {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  border: 1rpx solid #E5E7EB;
  line-height: 1.6;
  font-size: 28rpx;
  color: #374151;
}

.exam-option--selected {
  background: #EEF2FF;
  border-color: #6366F1;
  color: #4F46E5;
}

.exam-option-content {
  flex: 1;
}

.exam-input-contain {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  height: 80rpx;
  overflow: hidden;
}

.exam-input-contain-label {
  padding: 0 24rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 600;
  border-right: 1rpx solid #E5E7EB;
  background: #F3F4F6;
}

.exam-input-contain-content {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.exam-textarea-contain {
  margin: 12rpx 0;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  padding: 20rpx;
}

.exam-textarea-contain textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

/* ====== 批改区域 ====== */

.exam-grade-area {
  padding: 24rpx 0 8rpx;
  border-top: 1rpx solid #F3F4F6;
}

.exam-grade-result {
  margin-bottom: 16rpx;
}

.grade-right {
  display: inline-block;
  padding: 8rpx 32rpx;
  background: #DCFCE7;
  color: #16A34A;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.grade-wrong {
  display: inline-block;
  padding: 8rpx 32rpx;
  background: #FEE2E2;
  color: #DC2626;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.grade-pending {
  display: inline-block;
  padding: 8rpx 32rpx;
  background: #FEF3C7;
  color: #D97706;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.exam-grade-info {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.exam-grade-actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.grade-btn {
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.grade-btn--right {
  background: #DCFCE7;
  color: #16A34A;
  border: 1rpx solid #BBF7D0;
}

.grade-btn--wrong {
  background: #FEE2E2;
  color: #DC2626;
  border: 1rpx solid #FECACA;
}

.exam-grade-detail {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.8;
}

/* ====== rich-text ====== */

rich-text image, rich-text img {
  max-width: 100% !important;
  height: auto !important;
}

rich-text pre {
  background-color: #F3F4F6;
  padding: 16rpx;
  overflow-x: auto;
  font-size: 26rpx;
  border-radius: 8rpx;
}

rich-text code {
  font-family: Menlo, Monaco, Consolas, monospace;
  font-size: 26rpx;
}

rich-text table {
  border-collapse: collapse;
  width: 100%;
}

rich-text td, rich-text th {
  border: 1rpx solid #E5E7EB;
  padding: 8rpx 16rpx;
}

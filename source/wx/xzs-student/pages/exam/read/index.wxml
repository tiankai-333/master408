<wxs module="filter" src="../../../wxs/exam-fun.wxs"></wxs>
<view class="exam-page">
  <view class="view-wrap-hidden"></view>
  <view>
    <view class="exam-name-title">{{paper.name}}</view>
    <view class="exam-result">
      <view class="exam-result-score">得分: {{answer.score}}</view>
      <view class="exam-result-time">耗时: {{answer.doTime}}秒</view>
    </view>

    <i-panel title="{{titleItem.name}}" wx:for="{{paper.titleItems}}" wx:for-item="titleItem" wx:key="{{titleItem.name}}" i-class="exam-panel-title">
      <i-cell-group i-class="exam-cell">
        <i-cell wx:for="{{titleItem.questionItems}}" wx:key="{{questionItem.id}}" wx:for-item="questionItem">

          <!-- 单选题 -->
          <view wx:if="{{questionItem.questionType === 1}}" class="exam-question-block">
            <view class="exam-question-title">{{questionItem.itemOrder}}. {{questionItem.title}}</view>
            <view class="exam-option-group">
              <label class="exam-option-label {{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content ? 'exam-option--selected' : ''}}" wx:for="{{questionItem.items}}" wx:key="{{radioItem.prefix}}" wx:for-item="radioItem">
                <radio color="#6366F1" value="{{radioItem.prefix}}" checked="{{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content}}" disabled="true" />
                <rich-text nodes="{{radioItem.prefix}}. {{radioItem.content}}" class="exam-option-content" />
              </label>
            </view>
          </view>

          <!-- 多选题 -->
          <view wx:elif="{{questionItem.questionType === 2}}" class="exam-question-block">
            <view class="exam-question-title">{{questionItem.itemOrder}}. {{questionItem.title}}</view>
            <view class="exam-option-group">
              <label class="exam-option-label {{filter.indexOf(answer.answerItems[questionItem.itemOrder-1].content,radioItem.prefix) ? 'exam-option--selected' : ''}}" wx:for="{{questionItem.items}}" wx:key="{{radioItem.prefix}}" wx:for-item="radioItem">
                <checkbox color="#6366F1" value="{{radioItem.prefix}}" checked="{{filter.indexOf(answer.answerItems[questionItem.itemOrder-1].content,radioItem.prefix)}}" disabled="true" />
                <rich-text nodes="{{radioItem.prefix}}. {{radioItem.content}}" class="exam-option-content" />
              </label>
            </view>
          </view>

          <!-- 判断题 -->
          <view wx:elif="{{questionItem.questionType === 3}}" class="exam-question-block">
            <view class="exam-question-title">{{questionItem.itemOrder}}. {{questionItem.title}}</view>
            <view class="exam-option-group">
              <label class="exam-option-label {{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content ? 'exam-option--selected' : ''}}" wx:for="{{questionItem.items}}" wx:key="{{radioItem.prefix}}" wx:for-item="radioItem">
                <radio color="#6366F1" value="{{radioItem.prefix}}" checked="{{radioItem.prefix == answer.answerItems[questionItem.itemOrder-1].content}}" disabled="true" />
                <rich-text nodes="{{radioItem.content}}" class="exam-option-content" />
              </label>
            </view>
          </view>

          <!-- 填空题 -->
          <view wx:elif="{{questionItem.questionType === 4}}" class="exam-question-block">
            <view class="exam-question-title">{{questionItem.itemOrder}}. {{questionItem.title}}</view>
            <view class="exam-input-contain" wx:for="{{questionItem.items}}" wx:key="{{inputItem.prefix}}" wx:for-item="inputItem" wx:for-index="idx">
              <view class="exam-input-contain-label">{{inputItem.prefix}}</view>
              <input class="exam-input-contain-content" maxlength="-1" value="{{answer.answerItems[questionItem.itemOrder-1].contentArray[idx]}}" disabled="true" />
            </view>
          </view>

          <!-- 简答题 -->
          <view wx:else class="exam-question-block">
            <view class="exam-question-title">{{questionItem.itemOrder}}. {{questionItem.title}}</view>
            <view class="exam-textarea-contain">
              <textarea maxlength="-1" disabled="true">{{answer.answerItems[questionItem.itemOrder-1].content}}</textarea>
            </view>
          </view>

          <!-- 批改区域 -->
          <view class="exam-grade-area">
            <view class="exam-grade-result">
              <text class="grade-right" wx:if="{{answer.answerItems[questionItem.itemOrder-1].doRight==true}}">正确</text>
              <text class="grade-wrong" wx:elif="{{answer.answerItems[questionItem.itemOrder-1].doRight==false}}">错误</text>
              <text class="grade-pending" wx:elif="{{answer.answerItems[questionItem.itemOrder-1].doRight==null}}">待自批</text>
            </view>
            <view class="exam-grade-info">
              <text>得分: {{answer.answerItems[questionItem.itemOrder-1].score || 0}}</text>
              <text>满分: {{questionItem.score}}</text>
            </view>

            <!-- 待批改时显示自批改按钮 -->
            <view class="exam-grade-actions" wx:if="{{answer.answerItems[questionItem.itemOrder-1].doRight==null}}">
              <view class="grade-btn grade-btn--right" bind:tap="judgeQuestion" data-order="{{questionItem.itemOrder}}" data-correct="true">正确</view>
              <view class="grade-btn grade-btn--wrong" bind:tap="judgeQuestion" data-order="{{questionItem.itemOrder}}" data-correct="false">错误</view>
            </view>

            <view class="exam-grade-detail">
              <view>难度: <i-rate value="{{questionItem.difficult}}" i-class="exam-item-rate" /></view>
              <view wx:if="{{questionItem.analyze}}"><rich-text nodes="解析: {{questionItem.analyze}}" /></view>
              <view wx:if="{{questionItem.questionType==1||questionItem.questionType==2||questionItem.questionType==5}}"><rich-text nodes="正确答案: {{questionItem.correct}}" /></view>
              <view wx:elif="{{questionItem.questionType==3}}"><rich-text nodes="正确答案: {{filter.trueFalseFormatter(questionItem)}}" /></view>
              <view wx:elif="{{questionItem.questionType==4}}"><rich-text nodes="正确答案: {{questionItem.correctArray}}" /></view>
            </view>
          </view>
        </i-cell>
      </i-cell-group>
    </i-panel>

    <i-spin size="large" fix wx:if="{{spinShow}}"></i-spin>
    <i-message id="message" />
  </view>
</view>

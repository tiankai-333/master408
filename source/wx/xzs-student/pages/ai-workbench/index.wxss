.page {
  height: 100vh;
  background: #FAFAFE;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ====== 顶部三行：科目、知识点、组卷 ====== */

.top-panel {
  background: #fff;
  border-bottom: 1rpx solid #E5E7EB;
  flex-shrink: 0;
}

.top-row {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.top-row:last-child {
  border-bottom: none;
}

.top-row--gen {
  background: linear-gradient(135deg, #0EA5E9, #38BDF8);
}

.top-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  width: 140rpx;
  flex-shrink: 0;
}

.top-label--gen {
  color: #fff;
}

.top-value {
  flex: 1;
  font-size: 28rpx;
  color: #9CA3AF;
  text-align: right;
}

.top-value--active {
  color: #4F46E5;
  font-weight: 600;
}

.top-arrow {
  font-size: 32rpx;
  color: #D1D5DB;
  padding-left: 12rpx;
}

.top-hint {
  flex: 1;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: right;
}

/* ====== Chat ====== */

.chat-area { flex: 1; min-height: 0; padding: 16rpx 24rpx; overflow-y: auto; }
.chat-welcome { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; }
.welcome-avatar { width: 80rpx; height: 80rpx; border-radius: 40rpx; background: linear-gradient(135deg, #6366F1, #818CF8); color: #fff; font-size: 28rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.welcome-text { font-size: 28rpx; color: #6B7280; }
.message { display: flex; align-items: flex-start; margin-bottom: 20rpx; }
.message--user { justify-content: flex-end; }
.msg-avatar { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: linear-gradient(135deg, #6366F1, #818CF8); color: #fff; font-size: 20rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-right: 12rpx; }
.msg-avatar--user { background: linear-gradient(135deg, #8B5CF6, #A78BFA); margin-right: 0; margin-left: 12rpx; }
.msg-bubble { max-width: 70%; padding: 18rpx 22rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.6; word-break: break-word; }
.bubble--assistant { background: #fff; color: #111827; border: 1rpx solid #E5E7EB; }
.bubble--user { background: #6366F1; color: #fff; }

/* ====== Agent draft ====== */

.agent-draft { background: #F9FAFB; border: 1rpx solid #E0E7FF; border-radius: 12rpx; padding: 16rpx; margin-bottom: 12rpx; }
.draft-title { font-size: 28rpx; font-weight: 600; color: #4F46E5; margin-bottom: 12rpx; }
.draft-row { display: flex; gap: 24rpx; font-size: 24rpx; color: #374151; margin-bottom: 8rpx; }
.draft-reason { font-size: 22rpx; color: #6B7280; margin: 8rpx 0; }
.draft-actions { display: flex; justify-content: flex-end; margin-top: 12rpx; }
.draft-btn { padding: 12rpx 28rpx; border-radius: 8rpx; font-size: 26rpx; font-weight: 500; }
.draft-btn--confirm { background: #6366F1; color: #fff; }

/* ====== Typing indicator ====== */

.typing-indicator { display: flex; gap: 8rpx; padding: 8rpx 0; }
.typing-dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: #C7D2FE; animation: typing-bounce 1.2s infinite; }
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes typing-bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-10rpx); } }

/* ====== Input area ====== */

.input-area { display: flex; align-items: flex-end; padding: 16rpx 24rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #E5E7EB; gap: 12rpx; flex-shrink: 0; }
.input-field { flex: 1; min-height: 60rpx; max-height: 180rpx; padding: 12rpx 16rpx; background: #F3F4F6; border-radius: 16rpx; font-size: 28rpx; color: #111827; }
.send-btn { padding: 14rpx 28rpx; border-radius: 16rpx; background: #E5E7EB; color: #9CA3AF; font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.send-btn--active { background: #6366F1; color: #fff; }

/* ====== Quick action bar ====== */

.action-bar { display: flex; gap: 16rpx; padding: 12rpx 24rpx 0; background: #fff; flex-shrink: 0; }
.action-btn { padding: 16rpx 36rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: 500; }
.action-btn--profile { background: #EEF2FF; color: #4F46E5; }
.action-btn--paste { background: #F0FDF4; color: #16A34A; }
.action-btn--clear { background: #F3F4F6; color: #6B7280; }

/* ====== Compose modal ====== */

.compose-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 100; display: flex; align-items: center; justify-content: center; }
.compose-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); }
.compose-dialog { position: relative; width: 560rpx; background: #fff; border-radius: 24rpx; padding: 36rpx; z-index: 1; }
.compose-title { font-size: 32rpx; font-weight: 700; color: #111827; text-align: center; margin-bottom: 24rpx; }
.compose-info { font-size: 26rpx; color: #4F46E5; text-align: center; margin-bottom: 20rpx; }
.compose-row { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 0; }
.compose-label { font-size: 28rpx; color: #374151; font-weight: 500; }
.stepper { display: flex; align-items: center; gap: 20rpx; }
.stepper-btn { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: #F3F4F6; display: flex; align-items: center; justify-content: center; font-size: 32rpx; color: #374151; font-weight: 600; }
.stepper-value { font-size: 32rpx; font-weight: 700; color: #111827; min-width: 48rpx; text-align: center; }
.compose-actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.compose-cancel { flex: 1; padding: 20rpx; border-radius: 12rpx; text-align: center; font-size: 28rpx; color: #6B7280; background: #F3F4F6; }
.compose-confirm { flex: 1; padding: 20rpx; border-radius: 12rpx; text-align: center; font-size: 28rpx; color: #fff; background: #6366F1; font-weight: 600; }

/* ====== 科目选择弹窗 ====== */

.subject-pick-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.subject-pick-item {
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #374151;
  background: #F3F4F6;
  border-radius: 12rpx;
}

.subject-pick-item--active {
  background: #6366F1;
  color: #fff;
}

/* ====== 知识点选择弹窗 ====== */

.picker-search {
  margin-bottom: 16rpx;
}

.picker-search-input {
  padding: 16rpx 20rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #111827;
}

.popup-scroll--kp {
  max-height: 500rpx;
}

.picker-group {
  margin-bottom: 16rpx;
}

.picker-group-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.picker-item {
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #F9FAFB;
}

.picker-item--active {
  background: #EEF2FF;
}

.picker-item-name {
  display: block;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.picker-item-sub {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.popup-footer {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

.popup-clear {
  padding: 16rpx 48rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6B7280;
  background: #F3F4F6;
}

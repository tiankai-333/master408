<view class="my-page">
  <view class="hero">
    <view class="hero-kicker">408MASTER</view>
    <view class="hero-title">我的学习中心</view>
  </view>

  <view class="profile-card">
    <image class="avatar" src="{{avatarPath}}"></image>
    <view class="profile-main">
      <view class="profile-name">{{displayName}}</view>
      <view class="profile-subtitle">计算机考研 · 408 全科</view>
    </view>
    <view class="profile-link" bind:tap="openPage" data-url="/pages/my/info/index">档案</view>
  </view>

  <view class="section-title">学习档案</view>
  <view class="quick-list">
    <view class="quick-item" bind:tap="openPage" data-url="/pages/my/log/index">
      <view class="quick-content">
        <view class="quick-title">学习动态</view>
        <view class="quick-desc">查看最近练习和系统消息</view>
      </view>
      <view class="quick-arrow">›</view>
    </view>
    <view class="quick-item" bind:tap="openPage" data-url="/pages/record/index">
      <view class="quick-content">
        <view class="quick-title">考试记录</view>
        <view class="quick-desc">复查答题历史和得分变化</view>
      </view>
      <view class="quick-arrow">›</view>
    </view>
    <view class="quick-item" bind:tap="openPage" data-url="/pages/my/ai-keys/index">
      <view class="quick-content">
        <view class="quick-title">密钥信息</view>
        <view class="quick-desc">查看公共和私人 AI 密钥</view>
      </view>
      <view class="quick-arrow">›</view>
    </view>
  </view>

  <view class="section-title">设置</view>
  <view class="quick-list">
    <view class="quick-item danger" bind:tap="logOut">
      <view class="quick-content">
        <view class="quick-title">退出账号</view>
      </view>
      <view class="quick-arrow">›</view>
    </view>
  </view>

  <view class="copyright">408Master | 计算机考研学习助手</view>

  <i-spin size="large" fix wx:if="{{ spinShow }}"></i-spin>
  <i-message id="message" />
</view>

.my-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: #FAFAFE;
  color: #111827;
}

.hero {
  padding: 36rpx 32rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #4F46E5 0%, #818CF8 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.3);
}

.hero-kicker {
  color: #C7D2FE;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.profile-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #E0E7FF;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.06);
}

.avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #EEF2FF;
}

.profile-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.profile-subtitle {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 24rpx;
}

.profile-link {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #EEF2FF;
  color: #4F46E5;
  font-size: 24rpx;
  font-weight: 600;
}

.section-title {
  margin: 30rpx 4rpx 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.quick-list {
  overflow: hidden;
  border: 1rpx solid #E0E7FF;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(99, 102, 241, 0.06);
}

.quick-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #EEF2FF;
}

.quick-item:last-child {
  border-bottom: 0;
}

.quick-item.danger .quick-title {
  color: #EF4444;
}

.quick-content {
  flex: 1;
  min-width: 0;
}

.quick-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.quick-desc {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 23rpx;
}

.quick-arrow {
  color: #A5B4FC;
  font-size: 44rpx;
}

.copyright {
  margin-top: 28rpx;
  color: #9CA3AF;
  text-align: center;
  font-size: 23rpx;
}
